    "Card darkness %": {
      "description": "How dark the glass behind text is. 100 = the mode's default, 200 = solid.",
      "tab": "Look",
      "default": "100",
      "slider": {
        "min": 0,
        "max": 200,
        "step": 1,
        "cssVariable": "--glass-tint-pct",
        "unit": ""
      }
    },
    "Bar darkness %": {
      "description": "Extra backing for the sidebar, title bar and Store/Community header. 0 = the mode's default.",
      "tab": "Look",
      "default": "0",
      "slider": {
        "min": 0,
        "max": 100,
        "step": 1,
        "cssVariable": "--glass-bar-pct",
        "unit": ""
      }
    },
    "Text outline %": {
      "description": "Soft dark rim around text on the glass. 0 = off.",
      "tab": "Look",
      "default": "100",
      "slider": {
        "min": 0,
        "max": 100,
        "step": 1,
        "cssVariable": "--glass-halo-pct",
        "unit": ""
      }
    },
    "Frost blur px": {
      "description": "How much the glass blurs what is behind it. 0 = clear glass (lighter on the GPU).",
      "tab": "Look",
      "default": "18",
      "slider": {
        "min": 0,
        "max": 40,
        "step": 1,
        "cssVariable": "--glass-blur-px",
        "unit": ""
      }
    },
    "Backdrop glow %": {
      "description": "Strength of the two soft glows in the backdrop (Accent colour and Glass colour). 0 = plain dark gradient.",
      "tab": "Look",
      "default": "60",
      "slider": {
        "min": 0,
        "max": 100,
        "step": 1,
        "cssVariable": "--glass-glow-pct",
        "unit": ""
      }
    },
    "Corner radius px": {
      "description": "Roundness of cards and dialogs.",
      "tab": "Style",
      "default": "10",
      "slider": {
        "min": 0,
        "max": 24,
        "step": 1,
        "cssVariable": "--glass-radius-px",
        "unit": ""
      }
    },
