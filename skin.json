{
  "name": "Glass Desktop",
  "author": "GlassDesktop contributors",
  "description": "Frosted glass Steam: translucent, blurred cards and bars over one soft backdrop across Library, Store, Community, Settings and menus, with sharp, readable text. Pure CSS and JS: extract, enable, done.",
  "version": "5.0.0",
  "tags": [
    "Glass",
    "Frosted",
    "Dark"
  ],
  "UseDefaultPatches": false,
  "Patches": [
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": ".*Settings.*",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": ".*friendsui-container.*",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": ".*ModalDialogPopup.*",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": ".*FullModalOverlay.*",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": ".*Menu$",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": ".*Supernav$",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^notificationtoasts_.*",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^SteamBrowser_Find$",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^OverlayBrowser_Browser$",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^SP Overlay:.*",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^Steam Big Picture Mode$",
      "TargetCss": "css/glass.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^https://store\\.steampowered\\.com.*",
      "TargetCss": "css/web.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^https://help\\.steampowered\\.com.*",
      "TargetCss": "css/web.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^https://checkout\\.steampowered\\.com.*",
      "TargetCss": "css/web.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^https://steamcommunity\\.com/?([?#].*)?$",
      "TargetCss": "css/web.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^https://steamcommunity\\.com/(app|apps|discussions|workshop|market|groups|games|sharedfiles|search|my|stats|linkfilter|chat|broadcast|news|greenlight|tradeoffer|trade)([/?#].*)?$",
      "TargetCss": "css/web.css",
      "TargetJs": "js/glass.js"
    },
    {
      "MatchRegexString": "^https://steamcommunity\\.com/(id|profiles)/[^/]+/(home|friends|groups|followedgames|badges|gamecards|inventory|games|screenshots|videos|images|myworkshopfiles|recommended|reviews|wishlist|tradeoffers|edit|notifications|commentnotifications)([/?#].*)?$",
      "TargetCss": "css/web.css",
      "TargetJs": "js/glass.js"
    }
  ],
  "Conditions": {
    "Mode": {
